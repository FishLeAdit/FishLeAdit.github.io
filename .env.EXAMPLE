# Copy to .env.local and fill in from Supabase: Project Settings -> API.
# Both values are bundled into the public JS, so only use the publishable (anon) key,
# never the service_role key. Row Level Security keeps the table read-only.

# Despite the name, this is the Supabase project URL.
NEXT_PUBLIC_API_KEY="https://<project-ref>.supabase.co"
NEXT_PUBLIC_ANON_KEY="sb_publishable_..."
